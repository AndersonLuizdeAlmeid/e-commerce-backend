{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "ecommerce-api",
    "Audience": "ecommerce-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenAbsoluteDays": 30
  },
  "Auth": {
    "RefreshCookie": {
      "Name": "ecommerce_refresh",
      "Secure": true
    }
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "nao-responda@loja.local",
    "FromName": "Loja",
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "Outbox": {
    "PollingIntervalMilliseconds": 5000,
    "BatchSize": 20,
    "MaxAttempts": 5
  },
  "RateLimiting": {
    "Global": { "TokenLimit": 100, "TokensPerPeriod": 50, "ReplenishmentSeconds": 10 },
    "AuthStrict": { "PermitLimit": 5, "WindowSeconds": 60 },
    "AuthRefresh": { "PermitLimit": 20, "WindowSeconds": 60 },
    "PublicRead": { "PermitLimit": 120, "WindowSeconds": 60 },
    "CustomerWrite": { "TokenLimit": 30, "TokensPerPeriod": 10, "ReplenishmentSeconds": 10 }
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "AllowedHosts": "*"
}
